{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "build": {
      "dependsOn": [
        "transit"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "USES_ZONE_URL",
        "NODE_ENV"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "aeo": {
      "dependsOn": [
        "transit"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
